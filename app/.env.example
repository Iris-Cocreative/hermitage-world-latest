# Copy to .env.local (gitignored). Never commit real keys.

# Supabase. Local values come from `npm run db:status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security: used by the Stripe webhook,
# checkout, media links and scripts/make-staff.mjs. Store it as a sensitive
# environment variable on Vercel.
SUPABASE_SECRET_KEY=

# Stripe. Use a restricted key (rk_...) with Checkout Sessions write and
# Products/Prices read, from a sandbox while developing.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to http://127.0.0.1:4100/api/stripe/webhook`
# locally, or the endpoint's signing secret on the Dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Where the app is served. Used for the links in Stripe Checkout and emails.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4100
