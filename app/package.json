{
  "name": "@hermitage-world/app",
  "version": "0.1.0",
  "private": true,
  "description": "Hermitage World: the app side. Accounts, the shop and library, posts and the team's admin.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/sync-site.mjs && next dev -H 127.0.0.1 -p 4100",
    "build": "node scripts/sync-site.mjs && next build",
    "start": "next start -p 4100",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-site.mjs",
    "vendor": "node scripts/vendor.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "seed:library": "node scripts/seed-library.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "markdown-it": "^14.1.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.110.0",
    "typescript": "^5"
  }
}
